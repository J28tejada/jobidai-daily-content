# ============================================================================
# Ideas Diarias — variables de referencia
# COPIAR a .env y llenar. .env está en .gitignore: nunca se commitea.
#
# OJO: el workflow NO lee este archivo. En n8n las llaves van en
# Settings -> Credentials. Esto es documentación de qué necesitas a mano.
# ============================================================================

# --- Anthropic (credencial n8n: "Anthropic API") ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (credencial n8n: "Supabase - ideas_diarias") ---
# Usar la SERVICE_ROLE key, no la anon: la tabla tiene RLS y anon no escribe.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- n8n ---
# El cron de las 7am depende de esta timezone, no de la del workflow.
GENERIC_TIMEZONE=America/Santo_Domingo
TZ=America/Santo_Domingo

# --- WhatsApp ---
# Se reutiliza el bot existente de Jobidai. Llenar según cómo esté expuesto
# (endpoint HTTP local, credencial de n8n, etc.). Ver scripts/setup.md paso 4.
WHATSAPP_ENDPOINT=
WHATSAPP_DESTINO=
